# macOS and IDE metadata
.DS_Store
.idea/

# Xcode user-specific state
xcuserdata/
*.xcuserstate

# Xcode build and distribution artifacts
build/
DerivedData/
.DerivedData/
*.xcarchive
*.ipa
*.dSYM
*.dSYM.zip
*.swiftsourceinfo

# Swift Package Manager local artifacts
.build/
.swiftpm/

# Xcode generates this wrapper for the project. Keep the shared SwiftPM
# Package.resolved file trackable so application builds use the same versions.
*.xcodeproj/project.xcworkspace/contents.xcworkspacedata

# Local temporary files
*.log
*.orig
*.swp
*.tmp
